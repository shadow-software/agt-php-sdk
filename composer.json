{
    "name": "shadow-software/agt-php-sdk",
    "description": "PHP SDK for the American Gun Trader Dealer API",
    "homepage": "https://americanguntrader.com/docs/dealer-api",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ShadowSoftware\\Agt\\": "generated/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShadowSoftware\\Agt\\Test\\": "generated/test/",
            "ShadowSoftware\\Agt\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist"
    },
    "version": "3.10.0"
}
